# Export these values in your server shell; never put credentials in browser config.
PROOFPLAN_DATASET_ROOT=/path/to/junction-dataset
PROOFPLAN_MODEL_ROOT=/path/to/model-assets
# Restore/reuse the existing lifetime ledger; never start an empty replacement.
PROOFPLAN_BUDGET_LEDGER=/path/to/existing/gemini-ledger.sqlite3
PROOFPLAN_RESULTS_ROOT=/path/to/runtime-results
PROOFPLAN_CACHE_ROOT=/path/to/runtime-cache
PROOFPLAN_WORKER_URL=http://127.0.0.1:8766
PROOFPLAN_GEMINI_KEY_FILE=/path/to/private/key-file
# Candidate only; default v3 routing stays unchanged.
PROOFPLAN_PAIRED=0
